# .env.example
# Copiar a .env y ajustar si hace falta. Los defaults de abajo ya son los
# que usa docker-compose.yml si .env no existe — este archivo documenta
# qué variables existen, no es estrictamente necesario para la demo.

# Secreto de firma de JWT. Cambiar en cualquier despliegue real.
JWT_SECRET=change-me

# Credenciales del usuario demo, creadas automáticamente en el primer
# arranque (BD vacía). Ver backend/cmd/api/main.go (seedIfEmpty).
DEMO_EMAIL=demo@energy.local
DEMO_PASSWORD=demo1234

# Explicación por LLM (opcional, no implementada en este MVP — el motor
# genera explicaciones por plantillas independientemente de este valor).
LLM_EXPLAIN=0
ANTHROPIC_API_KEY=

# PORT, DB_PATH y DATA_DIR NO están en este archivo porque están fijas
# dentro de docker-compose.yml (no son configurables externamente).
